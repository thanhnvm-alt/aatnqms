# Firebase Configuration (Automatically added by set_up_firebase)
# To get your Firebase config, go to your Firebase Console > Project Settings > General > Your apps
# VITE_FIREBASE_API_KEY=
# VITE_FIREBASE_AUTH_DOMAIN=
# VITE_FIREBASE_PROJECT_ID=
# VITE_FIREBASE_STORAGE_BUCKET=
# VITE_FIREBASE_MESSAGING_SENDER_ID=
# VITE_FIREBASE_APP_ID=

# Gemini AI Configuration
# Lấy tại: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=

# SMTP Email Configuration (Khôi phục mật khẩu / Gửi OTP)
# Hỗ trợ SMTP AA Corporation hoặc Gmail SMTP (smtp.gmail.com port 587)
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=your-email@aacorporation.com
# SMTP_PASS=your-app-password
# SMTP_FROM="AA Corporation QMS" <no-reply@aacorporation.com>
